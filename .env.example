PAYLOAD_SECRET=mygeneratedsecret
DATABASE_URL=mongodb://127.0.0.1/template-ecommerce

COMPANY_NAME="Payload Inc."
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

ENABLE_SEED=false

# Google Gemini API keys for image analysis
GOOGLE_AI_API_KEY=your_key_here

# Printify (POD fulfillment)
PRINTIFY_API_TOKEN=printify_api_token_here
PRINTIFY_SHOP_ID=your_shop_id_here
PRINTIFY_WEBHOOK_SECRET=

# BFL API (Flux Pro Ultra + FLUX.2 Pro image generation)
# BFL_API_KEY=bfl_your_api_key_here

# Printify catalog sync (background cron)
# Set to "true" to enable automatic sync every 6h + boot sync
# Disabled by default to avoid unnecessary API calls during dev
ENABLE_PRINTIFY_SYNC=false

# Resend for email notifications
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@uglylook.com
RESEND_CREW_EMAIL=crew@uglylook.com
RESEND_CREW_NAME=UglyLook Crew